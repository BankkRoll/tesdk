{
  "name": "tesdk",
  "version": "0.0.0",
  "description": "Universal TypeScript SDK for the Tesla Fleet API — runs on Node, browsers, and edge runtimes.",
  "keywords": [
    "tesla",
    "fleet-api",
    "sdk",
    "typescript",
    "ev",
    "powerwall"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    ".",
    "examples/*"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:exports": "attw --pack .",
    "check:publish": "publint --strict",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:publish && npm run check:exports",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.37.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.14",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "author": "BankkRoll",
  "homepage": "https://github.com/BankkRoll/tesdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BankkRoll/tesdk.git"
  },
  "bugs": {
    "url": "https://github.com/BankkRoll/tesdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
