# Application client id from https://developer.tesla.com
#
# This is a public client: the browser holds the id, runs PKCE, and no secret
# is ever shipped to it. Register your Tesla application as a public client, or
# keep the secret on a real backend and adapt the dev proxy accordingly.
VITE_TESLA_CLIENT_ID=

# na (North America, Asia-Pacific) | eu (Europe, Middle East, Africa) | cn (China)
VITE_TESLA_REGION=na

# Must exactly match an allowed redirect URI on your Tesla application.
VITE_TESLA_REDIRECT_URI=http://localhost:5173/callback

# Upstream the dev proxy forwards to. Leave unset to use the regional Fleet
# API host for VITE_TESLA_REGION.
#
# Vehicles from 2021 onward reject unsigned commands. Signing happens over the
# Tesla Vehicle Command Protocol (protobuf + ECDH, signed with your private
# key), so no HTTP proxy can do it -- run Tesla's Vehicle Command Proxy and
# point this at it. The SDK swaps the host and nothing else changes.
#
#   https://github.com/teslamotors/vehicle-command
#
# Local sidecar: https://localhost:4443
#
# TESLA_PROXY_URL=https://localhost:4443

# Set to 1 when the Vehicle Command Proxy uses a self-signed certificate, so
# the dev proxy accepts it. Never enable this outside local development.
# TESLA_PROXY_INSECURE=1
