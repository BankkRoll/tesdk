# Application credentials from https://developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# na (North America, Asia-Pacific) | eu (Europe, Middle East, Africa) | cn (China)
TESLA_REGION=na

# Must exactly match an allowed redirect URI on your Tesla application.
TESLA_REDIRECT_URI=http://localhost:8788/callback

# Base URL override. Leave unset to talk to Fleet API directly.
#
# Vehicles from 2021 onward reject unsigned commands. Signing happens over the
# Tesla Vehicle Command Protocol (protobuf + ECDH, signed with your private
# key), so run Tesla's Vehicle Command Proxy and point this at it. The SDK
# swaps the host and nothing else changes.
#
#   https://github.com/teslamotors/vehicle-command
#
# Run `npm start -- fleet-status` to see which vehicles require it.
#
# TESLA_PROXY_URL=https://localhost:4443

# Set to any value to log every HTTP attempt.
# TESLA_DEBUG=1
